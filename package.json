{
  "name": "helm-planner",
  "version": "1.50.0",
  "description": "Helm — steer projects, phases, tasks and habits from your daily note. An Obsidian plugin.",
  "main": "main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs dev",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "seed": "node scripts/run.mjs scripts/seed-vault.ts",
    "serve:dev": "node scripts/run.mjs scripts/serve-dev.ts",
    "install:vault": "node scripts/install.mjs",
    "check:tooling": "node scripts/check-tooling.mjs"
  },
  "keywords": [
    "obsidian",
    "tasks",
    "projects",
    "habits",
    "daily-notes"
  ],
  "author": "Iwan Hoogendoorn",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^25.0.1",
    "obsidian": "1.14.4",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
